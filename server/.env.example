# Leave DATABASE_URL empty to use a local SQLite file (server/dev.sqlite).
DATABASE_URL=
SESSION_SECRET=change-me
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:5001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become admins on login
ADMIN_EMAILS=

# Optional: ElevenLabs read-aloud (falls back to browser speech if empty)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
